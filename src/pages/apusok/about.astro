---
import Layout from "../../layouts/Home.astro";
import "../../styles/about.css";

const seo = {
  title: "About | A Pusok",
  description: "About Page",
};
---

<Layout {seo} pageClass="about-page">
  <div class="about-wrap" id="about-top">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero-copy">
        <h1 id="about-title">About <em>me</em></h1>
        <p class="lead">I like to build models of the Earth on the computer.</p>
        <p class="invitation">
          If interested working with me as a PhD student or postdoctoral
          researcher, please get in touch to discuss projects that are broadly
          related to my expertise.
        </p>
        <p class="contact-line">
          Email: <a
            class="a_theme"
            href="mailto:adina.pusok@earth.ox.ac.uk"
            rel="nofollow">adina.pusok@earth.ox.ac.uk</a>
        </p>
      </div>
      <figure class="portrait-frame">
        <img
          src="/assets/img/profile2024.jpg"
          alt="Adina Pusok"
          width="1206"
          height="1604"
        />
      </figure>
    </section>
    <div class="about-layout">
      <aside class="section-index" aria-label="About page sections">
        <div class="section-index-inner">
          <p class="section-index-title">On this page</p>
          <nav aria-label="On this page">
            <a href="#work-experience" aria-current="location"
              >Work Experience</a
            >
            <a href="#education">Education</a>
            <a href="#funding-awards">Funding and Awards</a>
            <a href="#community-work">Community work</a>
            <a href="#teaching">Teaching</a>
          </nav>
        </div>
      </aside>
      <div class="about-sections">
        <section
          class="about-section"
          id="work-experience"
          aria-labelledby="work-experience-title"
        >
          <h2 id="work-experience-title">Work Experience</h2>
          <div class="section-body">
            <ol class="timeline" role="list">
              <li class="timeline-item" data-current>
                <p class="timeline-date">01/2024 - present</p>
                <div class="timeline-entry">
                  <p class="institution">
                    Department of Earth Sciences, University of Oxford, UK
                  </p><p class="position">
                    <i
                      >Royal Society University Research Fellow (OceanMelt
                      project)</i>
                  </p>
                </div>
              </li>
              <li class="timeline-item" data-current>
                <p class="timeline-date">10/2025 - present</p>
                <div class="timeline-entry">
                  <p class="institution">St. Anne's College, Oxford, UK</p><p
                    class="position"
                  >
                    <em>Stipendiary Lecturer in Earth Sciences</em>
                  </p>
                </div>
              </li>
              <li class="timeline-item">
                <p class="timeline-date">11/2021 - 06/2022</p>
                <div class="timeline-entry">
                  <p class="institution">Exeter College, Oxford, UK</p><p
                    class="position"
                  >
                    <em>Stipendiary Lecturer in Geophysics</em>
                  </p>
                </div>
              </li>
              <li class="timeline-item">
                <p class="timeline-date">06/2019 - 12/2023</p>
                <div class="timeline-entry">
                  <p class="institution">
                    Department of Earth Sciences, University of Oxford, UK
                  </p><p class="position">
                    <em
                      >Postdoctoral Research Associate (RIFT-O-MAT project)</em>
                  </p>
                </div>
              </li>
              <li class="timeline-item">
                <p class="timeline-date">10/2016 - 04/2019</p>
                <div class="timeline-entry">
                  <p class="institution">
                    Scripps Institution of Oceanography, UC San Diego, USA
                  </p><p class="position">
                    <em>John W. Miles Postdoctoral Fellow at IGPP</em>
                  </p>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <section
          class="about-section"
          id="education"
          aria-labelledby="education-title"
        >
          <h2 id="education-title">Education</h2>
          <div class="section-body">
            <ol class="timeline" role="list">
              <li class="timeline-item">
                <p class="timeline-date">01/2021 - 10/2021</p>
                <div class="timeline-entry">
                  <p class="institution">
                    Advance HE and CTL, University of Oxford, Oxford, United
                    Kingdom
                  </p><p class="position">
                    <em
                      >Associate Fellowship, Descriptor 1 UK Professional
                      Standards Framework (UKPSF)</em>
                  </p>
                </div>
              </li>
              <li class="timeline-item">
                <p class="timeline-date">07/2012 - 06/2016</p>
                <div class="timeline-entry">
                  <p class="institution">
                    Johannes Gutenberg University, Mainz, Germany
                  </p><p class="position">
                    <em>DPhil. in Natural Sciences - Geophysics</em>
                  </p>
                </div>
              </li>
              <li class="timeline-item">
                <p class="timeline-date">10/2008 - 06/2012</p>
                <div class="timeline-entry">
                  <p class="institution">
                    University of Oxford, Oxford, United Kingdom
                  </p><p class="position"><em>MEarthSci. Earth Sciences</em></p>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <section
          class="about-section"
          id="funding-awards"
          aria-labelledby="funding-awards-title"
        >
          <h2 id="funding-awards-title">Funding and Awards</h2>
          <div class="section-body">
            <div class="award-panel">
              <ul>
                <li>
                  2024 and 2025 University Researcher Representative Fellowship,
                  U. Oxford.
                </li>
                <li>
                  2023 Royal Society University Research Fellowship (8 years
                  funding, ~£1.5M). <a
                    class="a_theme"
                    target="_blank"
                    href="https://royalsociety.org/news/2023/10/early-career-researchers-funding-2023/"
                    >[Press release]</a>
                </li>
                <li>
                  2019 Editors' Citation for Excellence in Refereeing for
                  Geochem., Geophys., Geosyst. <a
                    class="a_theme"
                    target="_blank"
                    href="https://eos.org/agu-news/in-appreciation-of-agus-outstanding-reviewers-of-2019"
                    >[Press release]</a>
                </li>
                <li>
                  CIG Travel award to attend the international Geodynamics
                  workshops: 2019 Ada Lovelace (Siena, Italy), 2017 NetherMod
                  (Putten, the Netherlands).
                </li>
                <li>
                  John W. Miles Postdoctoral Fellowship, Cecil H. and Ida M.
                  Green Foundation, Scripps Institution of Oceanography, UCSD,
                  2016 - 2018.
                </li>
                <li>
                  Outstanding Student Poster Award (OSPA) at the EGU Annual
                  Meeting 2014, Vienna, Austria.
                </li>
                <li>
                  Academic Exhibition Prize in 2009, 2010, 2011, St. Anne's
                  College, University of Oxford, UK.
                </li>
              </ul>
            </div>
          </div>
        </section>

        <section
          class="about-section community"
          id="community-work"
          aria-labelledby="community-work-title"
        >
          <h2 id="community-work-title">Community work</h2>
          <div class="section-body">
            <p>
              I am one of those scientists actively involved in the scientific
              community, with initiatives behind and around research.
            </p>
            <p>
              Since June 2025, I have led the organising of the <a
                class="a_theme"
                target="_blank"
                href="https://www.mpls.ox.ac.uk/training/mpls-research-staff-forum"
                >Seafloor Explorer</a
              > online seminar series, dedicated to bring together UK/EU-based scientists
              working on ocean tectonic settings, across disciplines including but
              not limited to geology, geophysics, geochemistry, marine geosciences.
            </p>
            <p>
              Between 2020-2025, I focused on the <a
                class="a_theme"
                target="_blank"
                href="https://www.mpls.ox.ac.uk/training/mpls-research-staff-forum"
                >representation of postdocs</a
              > at U. Oxford, a need exacerbated by the COVID-19 pandemic to improve
              the postdoc experience regarding the leave management system, teaching
              pay, representation, resource allocation, training and support for
              fellowship and funding applications, and career progression. My roles
              included:
            </p><ul>
              <li>
                Research staff representative: co-chair within MPLS division,
                member of Research Staff Consultation Group, member of the
                Research&amp;Innovation Committee, U. Oxford (2024-2025)
              </li>
              <li>
                Postdoc representative in Department of Earth Sciences, Oxford
                (2021-2023)
              </li>
            </ul>
            <p>
              As the early career scientist (ECS) representative for the
              Geodynamics division at the European Geosciences Union
              (2016-2019), I set up the calendar of ECS activities including the
              Geodynamics 101 short course (that resulted in the <a
                class="a_theme"
                target="_blank"
                href="https://se.copernicus.org/articles/13/583/2022/se-13-583-2022-discussion.html"
                >GD101 paper</a
              >),
              <a
                class="a_theme"
                target="_blank"
                href="https://blogs.egu.eu/divisions/gd/">the division blog</a
              >, and the division social media. Occasionally, I also write for
              the EGU Geodynamics division Blog.
            </p>
            <p>
              When I have some spare time, I join high-school classrooms
              online in Romania (through Romanian Science Festival or other
              NGOs) or do local outreach for girls in STEM.
            </p>
            <p>
              Last but not least, I am active in the academic life
              surrounding my work:
            </p><ul>
              <li>Session convener at EGU and AGU meetings</li>
              <li>
                Organizer of the Oxford Fluids Network and Oxford Exoplanets
                Network annual workshops (2019)
              </li>
              <li>
                Organizer of Geophysics (GP) seminars, IGPP/SIO (2016-2018)
              </li>
              <li>
                Member of the Organizing Committee for the 'Plate Tectonics
                Symposium at SIO' - May 9-10, 2018
              </li>
              <li>
                Reviewer for Funding Agencies: NSF (USA), ANR (France),
                Alexander von Humboldt Foundation (DE).
              </li>
              <li>
                Reviewer: G-cubed, JGR - Solid Earth, Solid Earth, Tectonics,
                GSA Bulletin, Geology, Geophys. J. Int., Nature Rev. Earth Env.
              </li>
              <li>
                OSPA Judge at the AGU Fall Meetings, EGU General Assemblies
              </li>
            </ul><p>
              Some of this community work would not have been possible without
              the enthusiam of friends and fellow scientists. It takes a village
              to create a vibrant scientific community.
            </p>
          </div>
        </section>

        <section
          class="about-section teaching"
          id="teaching"
          aria-labelledby="teaching-title"
        >
          <h2 id="teaching-title">Teaching</h2>
          <div class="section-body">
            <p>
              As Lecturer in Earth Sciences at St. Anne's College, I teach
              undergraduate courses in Mathematics, Geophysics and Geodynamics
              in a variety of formats: lectures, practicals, tutorials. I also
              provide graduate training in Geodynamics to MSc/PhD students.
            </p>
            <p>
              While working from home and faced with online teaching in 2021, I
              decided to do a training course: the "Advanced Teaching and
              Learning" course, from the <a
                class="a_theme"
                target="_blank"
                href="https://www.ctl.ox.ac.uk"
                >Centre for Teaching and Learning</a
              >, Oxford, 2021. As a result, I completed the certification for <a
                class="a_theme"
                target="_blank"
                href="https://www.advance-he.ac.uk/fellowship/associate-fellowship"
                >Associate Fellowship by Advance HE</a
              > with the portfolio
              <i
                >Remote teaching an undergraduate computational course in Earth
                Sciences.</i
              >
            </p>
          </div>
        </section>
        <div class="about-actions">
          <a class="return-home" href="/">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"></path></svg
            >Return Home
          </a>
          <a class="back-top" href="#about-top">Back to top ↑</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const root = document.querySelector(".about-page");
  const sectionLinks = Array.from(
    root?.querySelectorAll<HTMLAnchorElement>(".section-index a") ?? []
  );

  function selectSection(id: string) {
    sectionLinks.forEach((link) => {
      if (link.hash === "#" + id) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }

  sectionLinks.forEach((link) => {
    link.addEventListener("click", () => selectSection(link.hash.slice(1)));
  });

  if (sectionLinks.some((link) => link.hash === window.location.hash)) {
    selectSection(window.location.hash.slice(1));
  }

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) selectSection(entry.target.id);
        });
      },
      { rootMargin: "-10% 0px -65% 0px", threshold: 0 }
    );
    root
      ?.querySelectorAll(".about-section")
      .forEach((section) => observer.observe(section));
  }
</script>
