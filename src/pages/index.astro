---
import Layout from "../layouts/Home.astro";
import HomeHeroSection from "../components/sections/heros/HomeHeroSection.astro";
---

<Layout>
  <div class="home-wrap">
    <HomeHeroSection />

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="section-head"><h2 id="projects-title">Projects & Tools</h2></div>
      <div class="cards">
        <a class="card" href="/apusok/research/">
          <div class="cardtop">
            <span>01 / PROJECTS</span><span>DISCOVER</span>
          </div>
          <h3>Research</h3>
          <p>
            Gallery of models we use to investigate the dynamics of Earth's interior.
          </p>
          <span class="go"
            ><svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14M13 5l7 7-7 7"></path></svg
            ></span
          >
        </a>
        <a class="card" href="/apusok/software/">
          <div class="cardtop">
            <span>02 / NUMERICAL METHODS</span><span>EXPLORE</span>
          </div>
          <h3>Software</h3>
          <p>
            Computational tools for geodynamic modelling.
          </p>
          <span class="go"
            ><svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14M13 5l7 7-7 7"></path></svg
            ></span
          >
        </a>
      </div>
    </section>

    <section class="news" id="news" aria-labelledby="news-title">
      <div class="news-intro">
        <h2 id="news-title">News</h2>
        <!-- <p>Updates from the group.</p> -->
        <span class="placeholder-note">Updates from the group</span>
      </div>
      <div class="news-list">
        <article class="news-item">
          <span class="news-category">People</span>
          <div>
            <h3>Oct 12, 2026. Amrithaa Velayutham joins the group as MSc student in 2026-2027.</h3><p>
              His project is entitled "Oceanic crustal production modulated by variations in seafloor spreading".
            </p>
          </div>
        </article>

        <article class="news-item">
          <span class="news-category">Research</span>
          <div>
            <h3>Research update headline</h3><p>
              A short summary of a paper, project, or result.
            </p>
          </div>
        </article>
        
        <!-- <article class="news-item">
          <span class="news-category">Events</span>
          <div>
            <h3>Seminar or event headline</h3><p>
              Details of an upcoming seminar, talk, or event.
            </p>
          </div>
        </article> -->
      </div>
    </section>
  </div>
</Layout>
