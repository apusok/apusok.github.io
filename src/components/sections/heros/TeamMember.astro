---
import { Container } from '@components/odyssey-theme';

const { reversed } = Astro.props;
---

<Container>
	<section
		class={`text-and-image__section ${
			reversed && `text-and-image__section--reversed`
		}`}
	>
		<div class="text-and-image__text">
			<slot name="text-container" />
			<div class="text-and-image__btns">
				<slot name="btns-container" />
			</div>
		</div>
		<div class="text-and-image__image">
			<slot name="image-container" />
		</div>
	</section>
</Container>

<style>
	.text-and-image__section {
		margin: 0 auto;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--theme-line);
		display: grid;
		grid-template-columns: minmax(0, 1fr) 180px;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.text-and-image__section--reversed {
		grid-template-columns: 180px minmax(0, 1fr);
	}
	.text-and-image__section--reversed .text-and-image__text {
		order: 2;
	}
	.text-and-image__text {
		padding: 0rem 0;
		justify-self: left;
		width: 100%;
	}
	.text-and-image__image :global(img) {
		width: 100%;
		height: auto;
		max-height: 240px;
		object-fit: contain;
		border-radius: var(--theme-shape-radius);
	}
	@media (max-width: 600px) {
		.text-and-image__section {
			padding: 2rem 0;
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.text-and-image__image {
			width: min(180px, 60%);
			grid-row: 1;
		}
		.text-and-image__text {
			padding: 0;
		}
	}
</style>
