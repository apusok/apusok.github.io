---
import { Container } from '@components/odyssey-theme';

const { reversed } = Astro.props;
---

<Container>
	<section
		class={`text-and-image__section ${
			reversed && `text-and-image__section--reversed`
		}`}
	>
		<div class="text-and-image__text">
			<slot name="text-container" />
			<div class="text-and-image__btns">
				<slot name="btns-container" />
			</div>
		</div>
		<div class="text-and-image__image">
			<slot name="image-container" />
		</div>
	</section>
</Container>

<style>
	.text-and-image__section {
		margin: 0 auto;
		padding: clamp(2.5rem, 5vw, 4.5rem) 0;
		border-top: 1px solid var(--theme-line);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
	}
	.text-and-image__section--reversed .text-and-image__text {
		order: 2;
	}
	.text-and-image__text {
		padding: 0rem 0;
		justify-self: start;
		max-width: 38rem;
	}
	.text-and-image__btns {
		margin-top: 1.5rem;
	}
	.text-and-image__image {
		color: var(--theme-muted);
		font-size: 0.8125rem;
	}
	.text-and-image__image :global(picture) {
		display: block;
		max-width: 100%;
	}
	.text-and-image__image :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
		border-radius: var(--theme-shape-radius);
	}
	@media (max-width: 768px) {
		.text-and-image__section {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.text-and-image__section--reversed .text-and-image__text {
			order: initial;
		}
		.text-and-image__text {
			padding: 2rem 0;
		}
	}
</style>
