<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <div class="eyebrow">University of Oxford · Earth Sciences</div>
    <h1 id="hero-title">
      Computational<br /> Fluid Dynamics<br /> for <em>Solid Earth</em>
    </h1>
    <div class="bio">
      <!-- <img
        class="portrait"
        src="/assets/img/profile2020.jpg"
        alt="Adina Pusok"
        width="76"
        height="93"
      /> -->
      <p class="desc">
        <a href="/apusok/team/">Research group</a> led by Dr. Adina Pusok, Royal Society University Research Fellow, at the <a
          href="https://www.earth.ox.ac.uk/"
          target="_blank"
          rel="noopener noreferrer">Department of Earth Sciences</a
        >, University of Oxford. Our work focuses on understanding the
        interior dynamics of the Earth. In particular, we build models of magma
        generation and transport from a partially-molten mantle all the way to
        the surface coupled with tectonic deformation. Also organising the <a
          href="https://seafloor-explorer.github.io/"
          target="_blank"
          rel="noopener noreferrer">Seafloor Explorer</a
        > seminar series.
      </p>
    </div>
  </div>
  <figure class="simulation">
    <div class="video-stage">
      <video
        id="simulation-video"
        controls
        playsinline
        preload="none"
        poster="/assets/img/convective-flow-poster.jpg"
        width="748"
        height="540"
        aria-label="Convective flow beneath mid-ocean ridges"
      >
        <source
          src="/assets/videos/FR1_dTdx005_beta2_4-15myr.mp4"
          type="video/mp4"
        />
      </video>
      <button
        class="video-play"
        type="button"
        aria-label="Play simulation"
        hidden
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M5 3.5v17L20 12z"></path></svg
        >
      </button>
    </div>
    <figcaption>Convective flow beneath mid-ocean ridges</figcaption>
  </figure>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>("#simulation-video");
  const playButton = document.querySelector<HTMLButtonElement>(".video-play");

  if (video && playButton) {
    playButton.hidden = false;
    playButton.addEventListener("click", () => {
      video.play().catch(() => {
        playButton.hidden = true;
        video.focus();
      });
    });
    video.addEventListener("play", () => {
      playButton.hidden = true;
    });
    video.addEventListener("pause", () => {
      playButton.hidden = false;
    });
    video.addEventListener("ended", () => {
      playButton.hidden = false;
    });
  }
</script>
