---
import { Container } from '@components/odyssey-theme';
---

<Container>
	<section class="hero-section__section">
		<div class="hero-section__text">
			<slot name="text-container"></slot>
		</div>
		<div class="hero-section__image">
			<slot name="image-container">
			</slot>
		</div>
	</section>
</Container>

<style>
	.hero-section__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 6rem);
	}
	.hero-section__text {
		justify-self: start;
		max-width: 36rem;
	}
	.hero-btns__container {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.hero-btns__container {
		margin-right: 1rem;
	}
	.hero-section__image {
		display: flex;
		justify-content: center;
	}
	.hero-section__image :global(picture) {
		width: min(100%, 340px) !important;
	}
	.hero-section__image :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
		border-radius: 180px 180px 4px 4px;
		box-shadow: 0 20px 45px rgb(var(--theme-ink-rgb) / 0.08);
	}
	@media (max-width: 768px) {
		.hero-section__section {
			margin: 2rem auto 0 auto;
			grid-template-columns: 1fr;
		}
	}
</style>
