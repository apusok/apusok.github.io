---
import Container from '../core/Container.astro';

const {surfaceNumber} = Astro.props;
---

<section class="constrained-text-hero__section" style={surfaceNumber && `--text-card-surface: var(--theme-surface-${surfaceNumber});`}>
  <Container narrow>
    <slot></slot>
  </Container>
</section>

<style>
.constrained-text-hero__section {
  margin: var(--section-margin) auto;
  padding: 0;
  border-radius: var(--theme-shape-radius);
  background: var(--text-card-surface, transparent);
}
</style>
