---
import { nav } from '../../config/nav.js';
import settings from '../../config/settings.js';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <a class="brand" href="/" aria-label={`${settings.name}, home`}>
    <img src="/assets/img/logo_transparent_small2.png" alt="" width="44" height="44" />
    <span class="name">{settings.name}</span>
  </a>
  <nav class="nav" aria-label="Main navigation">
    {nav.map((item) => <a href={item.slug} aria-current={currentPath === item.slug ? 'page' : undefined}>{item.title}</a>)}
  </nav>
  <a class="pill desktop-seminar" href="https://seafloor-explorer.github.io/" target="_blank" rel="noopener noreferrer">
    Seafloor Explorer Seminars
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
  </a>
  <details class="mobile">
    <summary>Menu <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
    <nav aria-label="Mobile navigation">
      {nav.map((item) => <a href={item.slug} aria-current={currentPath === item.slug ? 'page' : undefined}>{item.title}</a>)}
      <a href="https://seafloor-explorer.github.io/" target="_blank" rel="noopener noreferrer">Seafloor Explorer Seminars</a>
    </nav>
  </details>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile');
  if (mobileMenu) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu.open) {
        mobileMenu.open = false;
        mobileMenu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !mobileMenu.contains(event.target)) {
        mobileMenu.open = false;
      }
    });
  }
</script>

<style>
    a { color: inherit; text-decoration: none; }
    .header {
      width: min(1360px, calc(100% - 80px));
      margin-inline: auto;
      font-family: var(--theme-font-family-sans);
      font-size: 18px;
      line-height: 1.7;
      min-height: 88px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      border-bottom: 1px solid var(--theme-line);
    }
    .brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .brand img { width: 44px; height: 44px; object-fit: contain; }
    .name { font-size: 18px; font-weight: 700; letter-spacing: .015em; white-space: nowrap; }
    .nav { display: flex; align-items: center; gap: 26px; font-size: 17px; font-weight: 600; }
    .nav a { padding-block: 16px; }
    .nav a[aria-current='page'] {
      color: var(--theme-teal);
      text-decoration: underline;
      text-decoration-color: var(--theme-peach);
      text-decoration-thickness: 2px;
      text-underline-offset: 10px;
    }
    .mobile nav a[aria-current='page'] { color: var(--theme-teal); }
    .pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      border: 1px solid var(--theme-teal);
      border-radius: 999px;
      padding: 11px 17px;
      color: var(--theme-teal);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.5;
    }
    .pill:hover { background: var(--theme-teal); color: #fff; }
    .pill svg { width: 18px; height: 18px; flex-shrink: 0; }
    .mobile { display: none; position: relative; }
    .mobile summary {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 13px;
      border: 1px solid var(--theme-line);
      border-radius: 3px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .mobile summary::-webkit-details-marker { display: none; }
    .mobile summary svg { width: 19px; height: 19px; }
    .mobile nav {
      position: absolute;
      right: 0;
      top: calc(100% + 16px);
      z-index: 10;
      width: min(300px, calc(100vw - 40px));
      display: grid;
      padding: 16px 22px;
      background: var(--theme-bg);
      border: 1px solid var(--theme-line);
      box-shadow: 0 18px 40px rgb(var(--theme-ink-rgb) / 0.08);
    }
    .mobile nav a { padding-block: 8px; }
    .mobile nav a:last-child { border-top: 1px solid var(--theme-line); margin-top: 8px; padding-top: 16px; color: var(--theme-teal); }

    @media (max-width: 1150px) {
      .header { width: calc(100% - 56px); }
      .nav { gap: 18px; }
      .nav a { font-size: 16px; }
      .desktop-seminar { display: none; }
    }
    @media (max-width: 900px) {
      .header { min-height: 76px; }
      .nav { display: none; }
      .mobile { display: block; }
    }
    @media (max-width: 600px) {
      .header { width: calc(100% - 36px); gap: 12px; }
      .name { font-size: 16px; }
      .brand { gap: 8px; }
      .brand img { width: 35px; height: 35px; }
      .mobile summary { font-size: 14px; padding: 8px 10px; gap: 6px; }
    }
</style>
