---
import { Icon } from 'astro-icon/components';
import Container  from '../core/Container.astro';
import Plug from './Plug.astro';

const { footerSocials, footerLists, copyrightName, background, color, showPlug: showPlug = true, home = false } =
  Astro.props;
const email = footerSocials.find((social) => social.name === 'Email');
---

<footer
  class:list={{ 'footer--home': home }}
  style={background && `--footer-bg:${background}; --footer-color:${color}`}
>
  <Container>
    <div class="footer-grid__container">
      <div class="footer-brand__container">
        <div>
          <slot name="logo" />
        </div>
        {home && <div class="footer-affiliation">University of Oxford · Department of Earth Sciences</div>}
        <ul class="footer-socials__list">
          {
            footerSocials.map((social) => (
              <li class="footer-socials__item">
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-socials__link"
                  aria-label={social.name}
                  title={`Open ${social.name} profile`}
                >
                  <Icon name={social.icon} width={24} height={24} />
                </a>
              </li>
            ))
          }
        </ul>
        {showPlug && <Plug/>}
      </div>
      <div class="footer-links__container">
      <!-- {home && email && <a class="footer-email" href={email.url}>{email.url.replace(/^mailto:/, '')}</a>} -->
      {
        footerLists.map((list) => (
          <div>
            {!home && <p><strong>{list.title}</strong></p>}
            <ul class="footer-link__list" aria-label={list.title}>
              {list.items.map((item) => (
                <li>
                  <a target="_blank" rel="noopener noreferrer" href={item.slug}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      </div>
    </div>
    <div class="footer-copyright__container">
      <p>Copyright &copy; {new Date().getFullYear()} {copyrightName}, 
        build with <a target="_blank" href="https://github.com/treefarmstudio/odyssey-theme/">Odyssey Theme</a> 
        and hosted on <a target="_blank" href="https://github.com" rel="nofollow">Github</a>.
      </p>
    </div>

  </Container>
</footer>

<style>
  footer {
    --footer-bg: var(--theme-primary);
    --footer-color: var(--theme-on-primary);
    background-color: var(--footer-bg);
    color: var(--footer-color);
    padding: 3rem 0 1.5rem;
  }
  footer :global(p) {
    color: inherit;
  }
  footer :global(.odyssey-logo) {
    font-family: var(--theme-font-family-serif);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  footer a:hover {
    color: white;
    text-decoration: underline;
  }
  .footer-grid__container {
    padding: 0 0 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
  }
  .footer-socials__list {
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    list-style: none;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .footer-socials__item {
    margin: 0;
  }
  .footer-socials__link {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #ffffff28;
    border-radius: 50%;
    color: var(--theme-footer-link);
  }
  .footer-socials__link :global(svg) {
    width: 18px;
    height: 18px;
  }
  .footer-link__list {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--theme-footer-link);
    font-size: 0.8125rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .footer-link__list li {
    margin: 0;
  }
  .footer-link__list li a {
    text-decoration: none;
    white-space: nowrap;
  }
  .footer-link__list li a:hover {
    opacity: 0.84;
  }
  .footer-copyright__container {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #ffffff28;
    margin-top: 1rem;
    padding-top: 1.25rem;
    color: var(--theme-footer-muted);
    /* justify-content: space-between; */
  }
  .footer-copyright__container p {
    font-size: 0.6875rem;
    margin: 0;
  }
  .footer--home {
    padding: 30px 0 20px;
    line-height: 1.7;
  }
  .footer--home > :global(.content__container) {
    width: min(1360px, calc(100% - 80px));
    max-width: none;
    padding: 0;
  }
  .footer--home :global(.odyssey-logo) {
    font-size: 26px;
  }
  .footer-affiliation {
    margin-top: 8px;
    color: var(--theme-footer-affiliation);
    font-size: 14px;
    line-height: 1.6;
  }
  .footer--home .footer-grid__container {
    grid-template-columns: minmax(0, 1fr) minmax(0, 620px);
    gap: 32px;
    padding: 0;
  }
  .footer--home .footer-links__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: start;
    gap: 8px 22px;
  }
  .footer--home .footer-link__list,
  .footer-email {
    color: var(--theme-footer-link);
    font-size: 14px;
  }
  .footer-email {
    white-space: nowrap;
  }
  .footer--home .footer-copyright__container {
    margin-top: 22px;
    padding-top: 15px;
  }
  .footer--home .footer-copyright__container p {
    font-size: 12px;
  }
  @media (max-width: 1150px) {
    .footer--home > :global(.content__container) {
      width: calc(100% - 56px);
    }
  }
  @media (max-width: 1000px) {
    .footer--home .footer-grid__container {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .footer--home .footer-links__container {
      justify-content: flex-start;
    }
  }
  @media (max-width: 600px) {
    .footer--home > :global(.content__container) {
      width: calc(100% - 36px);
    }
    .footer--home .footer-links__container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 768px) {
    .footer-grid__container {
      padding: 0 0 1rem;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 600px) {
    .footer-grid__container {
      padding: 0 0 1rem;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .footer-copyright__container {
      flex-direction: column;
    }
  }
</style>
