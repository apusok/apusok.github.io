---
import { Icon } from 'astro-icon/components';
const { navData, rightMenu } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<script>
  const header = document.querySelector('#odysseyNavHeader');
  const menuButton = document.querySelector('#menuButton');
  const menuIcon = document.querySelector('#menuButtonIconHam');
  const closeIcon = document.querySelector('#menuButtonIconClose');

  function setMenuOpen(open: boolean) {
    header?.toggleAttribute('mobile-menu-open', open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('title', open ? 'Close Main Menu' : 'Open Main Menu');
    menuIcon?.toggleAttribute('hidden', open);
    closeIcon?.toggleAttribute('hidden', !open);
  }

  menuButton?.addEventListener('click', () => {
    setMenuOpen(!header?.hasAttribute('mobile-menu-open'));
  });

  header?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.hasAttribute('mobile-menu-open')) {
      setMenuOpen(false);
      (menuButton as HTMLButtonElement)?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !header?.contains(event.target)) {
      setMenuOpen(false);
    }
  });
</script>

<header id="odysseyNavHeader" class:list={{ 'header--right': rightMenu }}>
  <div class="header-logo-menu__container">
    <button id="menuButton" title="Open Main Menu" aria-expanded="false" aria-controls="site-navigation" type="button">
      <span id="menuButtonIconHam">
        <Icon name="ic:baseline-menu" width="24px" height="24px" />
      </span>
      <span id="menuButtonIconClose" hidden>
        <Icon name="ic:baseline-close" width="24px" height="24px" />
      </span>
    </button>
    <a class="header-logo__link" href="/">
      <slot name="logo" />
    </a>
  </div>
  <div id="site-navigation" class="header-nav__container">
    <slot name="nav">
      {navData && <nav aria-label="Main navigation">
        <ul>
          {navData.map(navItem => (
            <li><a href={navItem.slug} aria-current={currentPath === navItem.slug ? 'page' : undefined}>{navItem.title}</a></li>
          ))}
        </ul>
      </nav>}
    </slot>
    <div class="header-action-item__container">
      <slot name="action-item" />
    </div>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 20;
    width: calc(100% - clamp(2.25rem, 8vw, 7rem));
    max-width: 1320px;
    min-height: 96px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid var(--theme-line);
  }
  .header-logo__link {
    display: block;
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }
  .header-logo-menu__container,
  .header-nav__container {
    display: flex;
    align-items: center;
  }
  .header-logo-menu__container {
    flex-shrink: 0;
  }
  .header-nav__container {
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }
  #menuButton {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--theme-on-bg);
    border: 1px solid var(--theme-line);
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
  }
  #menuButton > span {
    line-height: 1;
  }
  #menuButton svg {
    display: block;
  }
  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.875rem);
  }
  nav li + li {
    margin-top: 0;
  }
  nav a {
    display: block;
    position: relative;
    padding: 0.75rem 0;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    color: inherit;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--theme-teal);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 2px;
    background: var(--theme-peach);
  }
  .header-action-item__container :global(.btn) {
    border: 1px solid var(--theme-teal);
    border-radius: 999px;
    background: transparent;
    color: var(--theme-teal);
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .header-action-item__container :global(.btn:hover) {
    background: var(--theme-teal);
    color: white;
  }
  @media (max-width: 1000px) {
    header {
      min-height: 76px;
    }
    .header-logo-menu__container {
      width: 100%;
      justify-content: space-between;
    }
    #menuButton {
      display: flex;
      order: 2;
      margin-left: 1rem;
      flex-shrink: 0;
    }
    .header-nav__container {
      display: none;
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      padding: 1.25rem;
      background: var(--theme-bg);
      border: 1px solid var(--theme-line);
      box-shadow: 0 20px 40px rgb(var(--theme-ink-rgb) / 0.08);
    }
    header[mobile-menu-open] .header-nav__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    nav a {
      padding: 0.6rem 0;
      font-size: 1rem;
    }
    .header-action-item__container {
      padding-top: 1rem;
      border-top: 1px solid var(--theme-line);
    }
    .header-action-item__container :global(.btn) {
      white-space: normal;
    }
  }
</style>
